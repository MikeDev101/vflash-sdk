set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(VFLASH_CROSS_PREFIX "arm-none-eabi-" CACHE STRING "GNU Arm executable prefix, optionally including its path")
find_program(CMAKE_C_COMPILER NAMES "${VFLASH_CROSS_PREFIX}gcc" REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
find_program(CMAKE_AR NAMES "${VFLASH_CROSS_PREFIX}ar" REQUIRED)
find_program(CMAKE_RANLIB NAMES "${VFLASH_CROSS_PREFIX}ranlib" REQUIRED)
find_program(CMAKE_OBJCOPY NAMES "${VFLASH_CROSS_PREFIX}objcopy" REQUIRED)
find_program(CMAKE_OBJDUMP NAMES "${VFLASH_CROSS_PREFIX}objdump" REQUIRED)
find_program(CMAKE_READELF NAMES "${VFLASH_CROSS_PREFIX}readelf" REQUIRED)
find_program(CMAKE_NM NAMES "${VFLASH_CROSS_PREFIX}nm" REQUIRED)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
